# Products API - REST Client Tests
#
# Swagger UI: http://localhost:8080/swagger-ui.html
# OpenAPI Docs: http://localhost:8080/v3/api-docs

### Get all products
GET http://localhost:8080/products

### Get a single product by id
GET http://localhost:8080/products/01

### Create a new product
POST http://localhost:8080/products
Content-Type: application/json

{
  "id": "04",
  "name": "Super Heavy vehicle",
  "description": "Can be used for very heavy work",
  "price": 3500
}

### Update a product (Task 3: Test updateProduct)
PUT http://localhost:8080/products/01
Content-Type: application/json

{
  "id": "01",
  "name": "Heavy vehicle - Updated",
  "description": "Updated description for heavy work",
  "price": 1500
}

### Delete a product
DELETE http://localhost:8080/products/03

#######################################
# ORDERS API
#######################################

### Get all orders
GET http://localhost:8080/orders

### Get a single order by id
GET http://localhost:8080/orders/1

### Get all orders for a specific product
GET http://localhost:8080/orders/product/01

### Create a new order (modify productId to match an existing product in your database)
POST http://localhost:8080/orders
Content-Type: application/json

{
  "productId": "01",
  "quantity": 5,
  "totalPrice": 6000,
  "orderDate": "2026-05-04T10:30:00",
  "status": "PENDING"
}

### Create another order for product 02
POST http://localhost:8080/orders
Content-Type: application/json

{
  "productId": "02",
  "quantity": 3,
  "totalPrice": 5400,
  "orderDate": "2026-05-04T11:00:00",
  "status": "COMPLETED"
}

### Update an order (modify the order id to match an existing order)
PUT http://localhost:8080/orders/1
Content-Type: application/json

{
  "productId": "01",
  "quantity": 10,
  "totalPrice": 12000,
  "orderDate": "2026-05-04T12:00:00",
  "status": "COMPLETED"
}

### Delete an order
DELETE http://localhost:8080/orders/2
